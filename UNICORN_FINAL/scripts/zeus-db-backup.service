[Unit]
Description=ZeusAI consistent SQLite DB backup (unicorn.db, tenants.db)
Documentation=https://github.com/ruffy80/ZeusAI

[Service]
Type=oneshot
Environment=HOME=/root
# Offsite (optional): set an rclone remote here to also push snapshots offsite,
# e.g. Environment=ZEUS_BACKUP_RCLONE_REMOTE=s3:my-bucket/zeus-db  (requires rclone configured)
ExecStart=/usr/local/bin/zeus-db-backup.sh
Nice=15
IOSchedulingClass=idle
TimeoutStartSec=600
SuccessExitStatus=0 1

[Install]
WantedBy=multi-user.target
