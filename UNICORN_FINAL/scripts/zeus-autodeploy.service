[Unit]
Description=ZeusAI billing-independent self-deploy (forward-only, canary-gated)
Documentation=https://github.com/ruffy80/ZeusAI
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# CRITICAL: PM2 keys its daemon off $HOME ($HOME/.pm2). Without HOME set, a
# systemd service defaults to /etc/.pm2 — a DIFFERENT daemon than the live
# processes under root's /root/.pm2 — so pm2 restart/start would silently miss
# the running backend/site and the deploy's build-SHA smoke would fail. Pin
# HOME/PM2_HOME to root's so the poller drives the same daemon as the live box.
Environment=HOME=/root
Environment=PM2_HOME=/root/.pm2
# The script is installed to a stable path outside the release tree so it keeps
# working across atomic symlink switches.
ExecStart=/usr/local/bin/zeus-auto-pull-deploy.sh
Nice=10
TimeoutStartSec=1200
# Never let a failed tick mark the unit as failed forever — the timer retries.
SuccessExitStatus=0 1

[Install]
WantedBy=multi-user.target
