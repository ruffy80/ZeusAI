# /etc/systemd/system/unicorn-healer.timer
[Unit]
Description=ZeusAI Unicorn Self-Healer Timer
Requires=unicorn-healer.service

[Timer]
# Give cold boot room before first probe; tick every 2 min (was 30s — too aggressive).
OnBootSec=120
OnUnitInactiveSec=120
AccuracySec=15
Unit=unicorn-healer.service

[Install]
WantedBy=timers.target
