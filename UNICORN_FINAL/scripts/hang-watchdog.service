# /etc/systemd/system/hang-watchdog.service
# ZeusAI / Unicorn — "TCP accept but HTTP hang" watchdog (one-shot).
#
# Detects the outage where nginx accepts connections but the Node upstreams
# (unicorn-backend :3000, unicorn-site :3001) never complete an HTTP request
# (frozen event loop), and force-recovers the guilty PM2 app with a SIGKILL
# escalation + nginx reload. Runs on a short timer (see hang-watchdog.timer).
[Unit]
Description=ZeusAI Unicorn Hang Watchdog (accept-but-hang detector)
After=network-online.target

[Service]
Type=oneshot
EnvironmentFile=-/var/www/unicorn/.env
EnvironmentFile=-/var/www/unicorn/.env.healer
# ARM the actuator (pm2 restart + nginx reload). Remove/set 0 to run
# detect-only (dry-run) while observing behaviour.
Environment=HANG_WATCHDOG_ARM=1
Environment=HANG_WATCHDOG_APP_DIR=/var/www/unicorn/UNICORN_FINAL
Environment=PM2_BIN=/usr/bin/pm2
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# Short HTTP timeout so a real hang is caught fast; boot-grace + threshold +
# cooldown keep it from thrashing pm2 during cold boots.
Environment=HANG_WATCHDOG_HTTP_TIMEOUT_MS=5000
# Threshold 2 + healthy-clear hysteresis: intermittent hang (healthy flicker
# between frozen ticks) still accumulates to actuation within ~90s of timer.
Environment=HANG_WATCHDOG_FAIL_THRESHOLD=2
Environment=HANG_WATCHDOG_HEALTHY_CLEAR=2
Environment=HANG_WATCHDOG_BOOT_GRACE_SEC=60
Environment=HANG_WATCHDOG_COOLDOWN_SEC=120
# Kill-switch: `touch /etc/zeus-hang-watchdog.disabled` makes the run a no-op.
ExecStartPre=/bin/sh -c '[ ! -f /etc/zeus-hang-watchdog.disabled ]'
ExecStart=/usr/bin/env node /var/www/unicorn/UNICORN_FINAL/scripts/hang-watchdog.js --once
# Hard runtime bound: the watchdog can NEVER hang forever — even if every
# probe stalls, systemd kills the unit and the next tick starts clean.
TimeoutStartSec=90
StandardOutput=journal
StandardError=journal
SyslogIdentifier=hang-watchdog
