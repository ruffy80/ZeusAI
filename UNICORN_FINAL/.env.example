NODE_ENV=development
PORT=3000
ADMIN_SECRET=change-me-to-a-strong-random-secret
JWT_SECRET=change-me-to-a-long-random-secret-in-production
SESSION_SECRET=change-me-to-a-long-random-session-secret-in-production

# ==================== DEEPSEEK — MOD AUTONOM PUTERE MAXIMĂ ====================
DEEPSEEK_API_KEY=your_deepseek_api_key_here        # <--- pune cheia reală aici pentru autonomie totală
DEEPSEEK_MODEL=deepseek-reasoner
DEEPSEEK_LOOP_ENABLED=1                            # <--- PORNEȘTE automat pe server!
DEEPSEEK_LOOP_EXECUTE=1                            # <--- EXECUTĂ (nu doar recomandă)!
DEEPSEEK_LOOP_ADMIN_TOKEN=your_admin_jwt_here      # <--- token admin puternic
DEEPSEEK_LOOP_INTERVAL_MS=60000                    # <--- la 60s, optimizează după nevoie

# ==================== FULFILLMENT AI ETERNAL OS ====================
# auto = armed forever when ≥1 real LLM key exists (recommended for production).
# 1 = force attempt AI for allowlisted SKUs; 0 = force off (deterministic packs only).
FULFILLMENT_AI_ENABLED=auto
# Optional: comma list, or * / all for every non-human digital SKU.
# FULFILLMENT_AI_SKUS=instant-seo-content-pack,instant-landing-page,instant-website-audit,instant-pitch-deck,instant-email-sequence


# ==================== AUTH GUARDIAN (permanent auth protection) ====================
AUTH_GUARDIAN_ENABLED=1
AUTH_GUARDIAN_TEST_EMAIL=auth.guardian@zeusai.pro
AUTH_GUARDIAN_TEST_PASSWORD=change-me-strong-passphrase
AUTH_GUARDIAN_TEST_NAME=AuthGuardian
AUTH_GUARDIAN_INTERVAL_MS=300000
AUTH_GUARDIAN_REPAIR_WINDOW_MS=30000
AUTH_GUARDIAN_BACKUP_KEEP=24
AUTH_GUARDIAN_ALERT_WEBHOOK=

# ==================== DATABASE ====================
# Path to the SQLite database file (default: ./data/unicorn.db)
# DB_PATH=./data/unicorn.db

# ==================== GITHUB ====================
GITHUB_OWNER=ruffy80
GITHUB_REPO=ZeusAI
GITHUB_REPO_NAME=ZeusAI
GITHUB_TOKEN=ghp_YOUR_PERSONAL_ACCESS_TOKEN_HERE
GIT_REMOTE_URL=https://github.com/ruffy80/ZeusAI.git

# ==================== APP URLs ====================
PUBLIC_APP_URL=https://zeusai.pro
SITE_DOMAIN=zeusai.pro
UNICORN_DOMAIN=www.zeusai.pro
CORS_ORIGINS=https://zeusai.pro,https://www.zeusai.pro,https://api.zeusai.pro,https://orchestrator.zeusai.pro

# ==================== PRIMARY MONEY RAILS (live checkout) ====================
# Buy flow is BTC-primary + PayPal + NOWPayments. Stripe is NOT required.
# Card payments are optional later — leave STRIPE_* empty if unused.

# ==================== PAYPAL (armed for checkout) ====================
PAYPAL_CLIENT_ID=YOUR_PAYPAL_CLIENT_ID
PAYPAL_CLIENT_SECRET=YOUR_PAYPAL_CLIENT_SECRET
# Legacy alias still accepted by UAIC / multi-payment-rails / paymentGateway:
# PAYPAL_SECRET=YOUR_PAYPAL_CLIENT_SECRET
# 'sandbox' for testing, 'live' for production
PAYPAL_ENV=live
# Webhook ID from PayPal Developer Dashboard > My Apps > Webhooks
# Required in production for automatic payment confirmation
PAYPAL_WEBHOOK_ID=YOUR_PAYPAL_WEBHOOK_ID
# Webhook URL to register in PayPal: https://zeusai.pro/api/payment/webhook/paypal

# ==================== NOWPAYMENTS (global crypto) ====================
NOWPAYMENTS_API_KEY=YOUR_NOWPAYMENTS_API_KEY
NOWPAYMENTS_IPN_SECRET=YOUR_NOWPAYMENTS_IPN_SECRET
# Set to 1 only for sandbox.nowpayments.io
# NOWPAYMENTS_SANDBOX=0
# IPN callback URL: https://zeusai.pro/api/payment/nowpayments/webhook

# ==================== CRYPTO WALLETS (BTC primary settlement) ====================
BTC_WALLET_ADDRESS=bc1q4f7e66z87mdfj56kz0dj5hvcnpmh0qh4wuv22e
# Optional aliases also accepted: OWNER_BTC_ADDRESS, LEGAL_OWNER_BTC, BTC_OWNER_WALLET
ETH_WALLET_ADDRESS=

# ==================== STRIPE (OPTIONAL — not used for Buy; add later only if you want cards) ====================
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_STARTER_MONTHLY=
# STRIPE_PRICE_STARTER_YEARLY=
# STRIPE_PRICE_PRO_MONTHLY=
# STRIPE_PRICE_PRO_YEARLY=
# STRIPE_PRICE_ENTERPRISE_MONTHLY=
# STRIPE_PRICE_ENTERPRISE_YEARLY=

# ==================== TELEGRAM (bot + profit group — live) ====================
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_OR_CHANNEL_ID
# Aliases accepted: TG_BOT_TOKEN, ZAC_TELEGRAM_TOKEN, ZAC_TELEGRAM_CHAT_ID
# Group/channel for TPG: ZEUS_TG_GROUP_CHAT_ID or TELEGRAM_GROUP_CHAT_ID
# MobDial MDB/1.0 (optional knobs — works with defaults once group is bound):
# ZEUS_TG_MOBDIAL_DISABLED=0
# ZEUS_TG_MOBDIAL_GOV_MAX=4
# ZEUS_TG_MOBDIAL_GOV_WINDOW_MS=600000
# ZEUS_TG_MOBDIAL_ECHO_GAP_MS=1200000
# ZAC_TELEGRAM_TOKEN=
# ZAC_TELEGRAM_CHAT_ID=
# ZEUS_TG_GROUP_CHAT_ID=@your_channel

# ==================== SMTP / EMAIL + AetherMail Continuum (AMC/1.0) ====================
# Buy does not require email. When you set SMTP_PASS, AetherMail arms automatically:
#   • outbound transactional mail (checkout receipts, resets…)
#   • IMAP receive (defaults imap.mail.yahoo.com from SMTP_HOST)
#   • Intent Lattice + Reply Gravity + Epistle Dial autonomous replies
#   • deferred queue flush (replies drafted before PASS was set get sent)
ADMIN_EMAIL=vladoi_ionut@yahoo.com
EMAIL_FROM_NAME=Zeus AI
# Yahoo SMTP example (use App Password – not your login password)
SMTP_HOST=smtp.mail.yahoo.com
SMTP_PORT=587
SMTP_USER=vladoi_ionut@yahoo.com
# SMTP_PASS=APP_PASSWORD_HERE
# Optional IMAP overrides (default: derived from SMTP_* — same Yahoo app password)
# IMAP_HOST=imap.mail.yahoo.com
# IMAP_PORT=993
# IMAP_USER=
# IMAP_PASS=
# ZEUS_AETHERMAIL_DISABLED=0
# ZEUS_AETHERMAIL_AUTO_REPLY=1
# ZEUS_AETHERMAIL_GRAVITY_MIN=55
# ZEUS_AETHERMAIL_MAX_REPLY_DAY=40
# Alternative: Gmail
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your@gmail.com
# SMTP_PASS=your-app-password
# Alternative: SendGrid
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=YOUR_SENDGRID_API_KEY

# ==================== HETZNER ====================
HETZNER_API_TOKEN=YOUR_HETZNER_API_TOKEN_HERE

# ==================== AWS (optional backup) ====================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BACKUP_BUCKET=unicorn-quantum-backup

# ==================== LEGAL / OWNER ====================
LEGAL_OWNER_NAME=Vladoi Ionut
LEGAL_OWNER_EMAIL=vladoi_ionut@yahoo.com
LEGAL_OWNER_BTC=bc1q4f7e66z87mdfj56kz0dj5hvcnpmh0qh4wuv22e

# ==================== ADMIN ====================
ADMIN_MASTER_PASSWORD=change-me-use-a-strong-password
ADMIN_2FA_CODE=change-me-use-a-real-2fa-code

# ... restul rămâne neschimbat ...

# --- Unicorn ↔ site live sync ---
# Pricing SSE refresh (ms). Default 5000 so storefront mirrors backend quickly.
LIVE_PRICING_REFRESH_MS=5000
# Master catalog in-process TTL (ms). Event services.changed still invalidates instantly.
MASTER_CATALOG_TTL_MS=10000

# --- Zeus Dropship OS (ZACC) ---
# Free world feeds (DummyJSON / FakeStore / Escuela) are always on — no keys required.
# They auto-list worldwide SKUs with real CDN images into /dropship.
# Optional supplier automation (true end-to-end dispatch needs at least CJ):
ZACC_ENABLED=1
ZACC_AUTO_APPROVE=1
ZACC_BOOT_PUBLISH=48
ZACC_WORLD_FEED_LIMIT=24
ZACC_WORLD_MIN_RATING=4.0
ZACC_CJ_API_KEY=
ZACC_CJ_ENDPOINT=https://developers.cjdropshipping.com/api2.0/v1/shopping/order/createOrder
ZACC_EBAY_APP_ID=
ZACC_ETSY_KEY=
ZACC_ALIEXPRESS_ENDPOINT=
ZACC_PRODUCT_FEED_URL=
ZACC_FULFILL_WEBHOOK_URL=
ZAC_TELEGRAM_TOKEN=
ZAC_TELEGRAM_CHAT_ID=

# ==================== ESSENTIAL MODULES CONTINUUM (EMC/1.0) ====================
# Mutators / auto-deploy stay OFF unless explicitly armed (Boot Immortal OS).
# ENABLE_FILE_MUTATORS=1
# ENABLE_AUTO_DEPLOY=1
# INNOVATION_GENERATE=1
# INNOVATION_AUTO_SHIP=0
# SELF_DOCUMENTER_AUTO=1
