      "resourceBudget": {
        "maxCpuMs": 3000,
        "maxMemoryMb": 256
      }
    },
    {
      "id": "runRedTeamAudit",
      "type": "read",
      "schedule": "*/15 * * * *",
      "timeout_ms": 10000,
      "resourceBudget": {
        "maxCpuMs": 2000,
        "maxMemoryMb": 128
      }
    },
    {
      "id": "getOrganismManifest",
      "type": "read",
      "schedule": "*/60 * * * * *",
      "timeout_ms": 5000,
      "resourceBudget": {
        "maxCpuMs": 1000,
        "maxMemoryMb": 128
      }
